# En-têtes de sécurité pour un hébergement Apache (équivalents de nginx.conf).
# Sans effet sous Docker/nginx, qui ne lit pas ce fichier et refuse de le servir.
DirectoryIndex index.html
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://geo.api.gouv.fr https://oudonner.api.efs.sante.fr; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Redirection HTTP → HTTPS (facultative). À activer seulement si le panneau de l'hébergeur
# ne le fait pas déjà (cPanel : Domaines → « Forcer la redirection HTTPS ») : les deux
# ensemble ne posent pas de problème, mais un seul suffit.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteCond %{HTTP:X-Forwarded-Proto} !=https
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>
